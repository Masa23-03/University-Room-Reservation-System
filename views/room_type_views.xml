<odoo>

    <record id='room_type_view_form' model="ir.ui.view">
        <field name="name">room.type.form</field>
        <field name="model">room.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>

                            <field name="name" />

                        </h1>

                    </div>
                    <group>


                        <label for="description" string="Description" />
                        <field name="description" nolabel="1" />
                    </group>
                </sheet>
            </form>


        </field>
    </record>

    <record id='room_type_action' model="ir.actions.act_window">
        <field name="name">Room Type</field>
        <field name="res_model">room.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="room_type_view_form" />

    </record>
</odoo>