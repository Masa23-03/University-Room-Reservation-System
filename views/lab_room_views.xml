<odoo>

    <record id="lab_room_view_form" model="ir.ui.view">
        <field name="name">lab.room.form</field>
        <field name="model">lab.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>

                    <group>
                        <field name="lab_type_id" />
                        <field name="capacity" />
                        <field name="floor" />
                        <field name="department" />
                        <field name="faculty" />
                        <field name="building" />
                        <field name="supervisor_id" />
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <record id="lab_room_action" model="ir.actions.act_window">
        <field name="name">Labs</field>
        <field name="res_model">lab.room</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>